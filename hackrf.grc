    rangeType: float
    start: '-1'
    step: '1'
    stop: '60'
    value: '60'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [312, 580.0]
    rotation: 0
    state: enabled
- name: bw

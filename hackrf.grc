    rotation: 0
    state: enabled
- name: cycle_period
  id: variable
  parameters:
    comment: ''
    value: (dwell_time * (num_antennas + 1))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [496, 92.0]
    rotation: 0
    state: enabled
- name: cycle_samples
  id: variable
  parameters:
    comment: ''
    value: cycle_period * samp_rate
